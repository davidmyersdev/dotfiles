#!/usr/bin/env bash
#
# An idempotent init script to ensure these dotfiles are correctly configured
# for the current user.

backup_dir=$(mktemp -d -t dotfiles-backup)

function link-module() {
  local module="$1"

  link-module-bins "$module"
  link-module-dir "$module" __home__
  link-module-dir "$module" __xdg_config_home__
}

function link-module-bins() {
  local module="$1"

  local bin_dir="./modules/${module}/__bin__"

  if ! test -d "$bin_dir"
  then
    return 0
  fi

  ls -A1 "$bin_dir" | while read -r bin
  do
    link-with-backup "$bin_dir/$bin" "${XDG_BIN_HOME}/${bin%.*}"
  done
}

# Note: This function currently assumes we already have Homebrew deps installed,
# because it relies on the `grealpath` util.
function link-module-dir() {
  local module="$1"
  local module_dir="$2"

  local path_to_source=""
  local path_to_symlink=""

  # Todo: Make sure targets exist too. If not, we can likely just return early.
  case "$module_dir" in
    __home__)
      if ! test -d "./modules/${module}/__home__"
      then
        return 0
      fi

      ls -A1 "./modules/${module}/__home__" | while read -r source
      do
        link-with-backup "./modules/${module}/__home__/${source}" "${HOME}/${source}"
      done
      ;;
    __xdg_config_home__)
      link-with-backup "./modules/${module}/__xdg_config_home__" "${XDG_CONFIG_HOME}/${module}"
      ;;
    *)
      echo "Unknown module dir: ${module_dir}" >&2

      return 1
      ;;
  esac
}

function link-with-backup() {
  local path_to_source="$1"
  local path_to_symlink="$2"

  if ! test -d "$(dirname "$path_to_symlink")"
  then
    mkdir -p "$(dirname "$path_to_symlink")"
  fi

  local absolute_path_to_source=$(grealpath "$path_to_source")
  local absolute_path_to_symlink=$(grealpath --no-symlinks "$path_to_symlink")
  local absolute_path_to_backup="${backup_dir}/${absolute_path_to_symlink#/}"
  local relative_path_to_source=$(grealpath --relative-to $(dirname "$absolute_path_to_symlink") "$absolute_path_to_source")

  if test -L "$absolute_path_to_symlink"
  then
    local existing_link="$(readlink "$absolute_path_to_symlink")"

    if test "$existing_link" = "$relative_path_to_source"
    then
      # If a link already exists and points to the correct location, we can move on.
      return 0
    fi
  fi

  if test -e "$absolute_path_to_symlink"
  then
    mkdir -p "$absolute_path_to_backup"

    mv "$absolute_path_to_symlink" "$absolute_path_to_backup"
  fi

  ln -s  "$relative_path_to_source" "$absolute_path_to_symlink"
}

# Common utils
link-with-backup "${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password" "${XDG_DATA_HOME}/apps/1password/container"

# Todo: Run each module layer-by-layer instead.
#
# - link-module-zshenvs
# - link-module-bins
# - link-module-dirs (cache, config, data, and state)
# - link-module-zprofiles
# - link-module-zshrcs (depends on envs + dirs being present)
ls -A1 ./modules | while read -r module
do
  link-module "$module"
done

if test -n "$(ls -A "$backup_dir")"
then
  echo "Backup: ${backup_dir}"
fi

# Hammerspoon init
{
  hammerspoon_config_file=$(defaults read org.hammerspoon.Hammerspoon MJConfigFile 2> /dev/null || echo "")

  if ! test "$hammerspoon_config_file" = "~/.config/hammerspoon/init.lua"
  then
    echo "Setting Hammerspoon config (previously '${hammerspoon_config_file}')"
  fi

  # https://github.com/Hammerspoon/hammerspoon/issues/1734
  defaults write org.hammerspoon.Hammerspoon MJConfigFile "~/.config/hammerspoon/init.lua"
}
